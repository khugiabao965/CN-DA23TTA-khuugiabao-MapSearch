# Sao chép thành .env rồi sửa nếu cần. Mọi giá trị đều có mặc định.
PORT=3000
HOST=127.0.0.1

# Mặc định là data/ban-do.db trong thư mục dự án
# DB_FILE=D:/du-lieu/ban-do.db

# Đặt production khi chạy qua HTTPS: cookie phiên có cờ Secure và db:seed bị chặn
NODE_ENV=development

# Bật khi chạy sau reverse proxy (nginx...): số lớp proxy, hoặc "loopback" nếu proxy cùng máy
# TRUST_PROXY=loopback
